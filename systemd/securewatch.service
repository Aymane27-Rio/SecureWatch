[Unit]
Description=SecureWatch One-off Security Audit
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/securewatch
Environment=SECUREWATCH_CONFIG=/etc/securewatch/securewatch.conf
ExecStart=/usr/bin/securewatch scan
User=root
UMask=0077
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
